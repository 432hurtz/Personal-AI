# Minimal Privoxy: expose an HTTP proxy on :8118 that forwards everything into
# Tor's SOCKS port. forward-socks5t resolves DNS through Tor too (no leaks),
# and works for .onion addresses.
listen-address 0.0.0.0:8118
forward-socks5t / 127.0.0.1:9050 .
# keep it quiet / no on-disk request logs
toggle 0
